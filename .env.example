# ---- chain ----
HOOD_RPC=https://rpc.mainnet.chain.robinhood.com

# ---- contracts, filled in by script/Deploy.s.sol ----
HOOD_FACTORY=
HOOD_FEE_ROUTER=
HOOD_STAKING=
HOOD_GRADUATOR=
HOOD_BRIDGE_FACTORY=
# the direct machine
HOOD_PORTAL=
HOOD_DIRECT_DEPLOYER=
HOOD_TOKEN_IMPLEMENTATION=
HOOD_BUYBACK_MODULE=
# the block the factory was deployed in; the indexer starts here and never before
HOOD_START_BLOCK=

# ---- deployment keys: generate fresh wallets for this project, reuse nothing ----
PRIVATE_KEY=
OWNER=
TREASURY=
KEEPER_PRIVATE_KEY=

# ---- off chain ----
POSTGRES_PASSWORD=
DATABASE_URL=postgres://hood:password@db:5432/hood
NEXT_PUBLIC_API_URL=https://api.hood.fam
# the site's own public URL, used to make share cards absolute
NEXT_PUBLIC_SITE_URL=https://hood.fam

# A fallback ETH/USD price, used only when the Chainlink feed on 4663 cannot be read. Points stop
# growing without a price, so this is a floor rather than a nicety.
HOOD_ETH_USD=

# ---- optional ----
# token art generation in the launch wizard and in the MCP server
OPENROUTER_API_KEY=
# in-app cross-chain buy quotes; without it the app links out to Relay's own page
RELAY_API_KEY=

# ---- support desk ----
# the AI assistant behind the help button; without a key the button still opens tickets
ANTHROPIC_API_KEY=
# SUPPORT_MODEL=claude-opus-5   SUPPORT_EFFORT=medium   SUPPORT_RATE_LIMIT=30 (messages per IP per 10 min)
# A day's tokens, after which the desk answers offline and opens tickets instead. An IP is not
# an identity, so the per-IP limit is a speed bump and this is the number that bounds the bill.
# SUPPORT_DAILY_TOKEN_BUDGET=3000000   (0 turns the budget off)
# SUPPORT_FALLBACKS=0 turns off the server-side refusal fallback

# ---- admin ----
# bearer token for /admin/* and the ticket queue, and the password of the /admin page in the app.
# Generate it (openssl rand -hex 32); leave it empty and nothing administrative answers over HTTP.
HOOD_ADMIN_TOKEN=
# requests per IP per minute on the public API; /health is exempt, admin routes get 60
RATE_LIMIT_PER_MINUTE=300
# set to 1 to exempt 127.0.0.1 (a keeper or a harness on the same box)
RATE_LIMIT_TRUST_LOCAL=0
# behind Traefik/Coolify the client address arrives in X-Forwarded-For; keep this true there
TRUST_PROXY=true

# ---- token chat ----
# Signs the session a wallet gets after it signs the login message, so nothing about a session is
# stored. Falls back to HOOD_ADMIN_TOKEN, and then to a secret made at boot, which logs a warning
# and signs every wallet out on every restart. Generate it (openssl rand -hex 32).
CHAT_SECRET=

# ---- token art storage (Cloudflare R2, or any S3-compatible bucket) ----
# With any of the five empty, POST /uploads/image answers 501 and both wizards fall back to the
# artwork URL field. Nothing else in the API depends on it.
R2_ENDPOINT=              # the S3 API endpoint, https://<account>.r2.cloudflarestorage.com
R2_BUCKET=                # the bucket the art objects live in
R2_ACCESS_KEY_ID=         # an R2 API token with object read and write on that bucket
R2_SECRET_ACCESS_KEY=     # its secret
R2_PUBLIC_BASE=           # where those objects are served from: https://pub-xxx.r2.dev or a custom domain
R2_REGION=auto            # R2 wants auto; a real S3 bucket wants its own region
UPLOAD_MAX_BYTES=4194304  # cap per image, counted while the upload streams

# ---- wallets ----
# Without this the site only offers injected wallets, which means desktop extensions only. A free
# project id from WalletConnect turns on the QR flow that phone wallets use.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# ---- announcements ----
# The announcer posts launches and graduations. It is started with the `announcer` profile and
# holds no key of any kind; with neither of these set it runs and logs what it would have posted.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# any endpoint that takes {"content": "..."} as JSON, which is Discord's shape and most others'
ANNOUNCE_WEBHOOK=
# ANNOUNCER_INTERVAL_MS=60000  ANNOUNCE_MIN_USD=0  ANNOUNCE_MAX_AGE_MINUTES=180

# ---- the demo world ----
# A preview seeded with `npm run demo -w @hood/api -- seed --yes --wipe` shows invented launches,
# wallets and trades so the product can be looked at full. Set this to 1 in that build and every
# page carries the strip that says the data is invented; leave it empty everywhere else.
NEXT_PUBLIC_DEMO=
# the seeded wallet the strip links to, printed by the seeder
NEXT_PUBLIC_DEMO_WALLET=

# ---- the season drop ----
# the claim contract for season pools (script/DeploySeasonDrop.s.sol); empty means no drop yet
HOOD_SEASON_DROP=
# what share of the season's protocol take the treasury commits to the pool, in bps.
# Announce it BEFORE a season starts. 3000 = 30%.
SEASON_POOL_BPS=3000
# a launch earns its 500 points only once the token has traded this much, so printing empty tokens
# is not the cheapest way to farm a season
LAUNCH_POINTS_MIN_USD=1000
# locking pays for the time it stays locked. The indexer credits it on this clock, and skips any
# position that has not been open this long since its last credit, so the two together decide how
# fresh the board is and how many rows a season writes.
STAKE_ACCRUAL_EVERY_MS=300000
STAKE_ACCRUAL_MIN_MINUTES=60
# the curve's two fee legs, as the deployed presets set them; only change if a preset differs
HOOD_CURVE_PROTOCOL_FEE_BPS=30
HOOD_CURVE_CREATOR_FEE_BPS=70

# ---- backups ----
# the backup container dumps the database on this schedule and keeps this many days locally
BACKUP_EVERY_SECONDS=21600
BACKUP_KEEP_DAYS=14
# optional offload of the dumps to S3-compatible storage: docker compose --profile offload up -d
BACKUP_S3_PROVIDER=Cloudflare
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=

# ---- the Safe that owns the protocol (docs/RUNBOOK.md 0a) -------------------------------------
# Created by script/DeploySafe.s.sol, then set as OWNER and TREASURY of the deployment.
HOOD_SAFE=
# Signers and threshold, read only by that script. Never the deployer key.
SAFE_OWNERS=
SAFE_THRESHOLD=2
# Only for a rehearsal, or a signer whose key is in the hood keystore: `npm run safe -- ... --sign`.
# On mainnet the signers sign in Safe{Wallet} and nothing here holds a key.
SAFE_SIGNER_KEYS=
# Optional. Lets `npm run safe -- ... --propose` put a transaction in the Safe's queue for the other
# signers (developer.safe.global). Reading the queue needs no key; writing to it does.
SAFE_API_KEY=
# Only for an organisation running its own Safe{Wallet}: the exact origin it is served from, which
# is then allowed both as the app's wallet and as a frame around it.
NEXT_PUBLIC_SAFE_APP_ORIGINS=
